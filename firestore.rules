rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // عضو = حد سجّل بكود الشلة (مستند members باسم الـ uid بتاعه)
    function signedIn() { return request.auth != null; }
    function memberDoc() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid)); }
    function myId() { return memberDoc().userId; }

    // التسجيل: لازم الكود يكون AY2009
    match /members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.code == 'AY2009'
                    && request.resource.data.keys().hasOnly(['userId', 'code']);
    }

    // ملف خاص بيربط الحساب بالبروفايل
    match /private/{id} {
      allow read, write: if isMember() && myId() == id;
    }

    // بروفايلات الكل: الكل بيقرا، صاحب الحساب بيعدّل كله، والباقي بيعدّل المكافآت والتاريخ بس
    match /users/{id} {
      allow read: if isMember();
      allow create: if isMember() && myId() == id;
      allow update: if isMember() && (myId() == id
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bonusJson', 'historyJson']));
    }

    // المبارزات والفرق
    match /duels/{id}  { allow read, write: if isMember(); }
    match /teams/{id}  { allow read, write: if isMember(); }
    match /tduels/{id} { allow read, write: if isMember(); }

    // مين شغّال دلوقتي
    match /presence/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // محفظة كل لاعب: هو بس اللي يكتب فيها
    match /wallet/{id} {
      allow read: if isMember();
      allow write: if isMember() && myId() == id;
    }

    // تعويض المبارزات: الخسران بيكتب التحويل
    match /transfers/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.from == myId();
    }

    // وحش الأسبوع واللعبة: بيتعمل مرة واحدة ومتتعدلش
    match /weekly/{wk} {
      allow read: if isMember();
      allow create: if isMember();
    }

    // حرب المناطق
    match /war/{doc} {
      allow read, write: if isMember();
    }
  }
}
